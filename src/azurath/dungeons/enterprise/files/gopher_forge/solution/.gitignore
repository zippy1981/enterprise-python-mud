# Azurath keeps your save game here. It is not part of your project.
.azurath/

# Python bytecode caches (like bin/ and obj/ in .NET)
__pycache__/
*.py[cod]

# Virtual environments: build artifacts, never commit them
.venv/

# Local secrets and overrides
.env
local.settings.json

# Azure Functions Core Tools
.python_packages/

# Native build outputs (scripts/build_go.py)
*.so
*.dylib
*.dll
*.pyd
